---
interface Props {
  title: string;
  href: string;
  date: string;
  tags: string[];
  description: string;
}

const { title, href, date, tags, description } = Astro.props;
---

<article class="post">
  <h3><a href={href}>{title}</a></h3>
  <div class="meta">
    <span class="date">{date}</span>
    {tags.map((tag) => <span class="tag">#{tag}</span>)}
  </div>
  <p class="desc">{description}</p>
  <a href={href} class="read-more">Read more →</a>
</article>

<style>
  .post {
    padding: 26px 0;
    border-bottom: 1px solid var(--border);
  }

  .post:last-child {
    border-bottom: none;
  }

  h3 {
    margin: 0 0 9px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.3px;
    line-height: 1.3;
  }

  h3 a {
    color: var(--text-link);
    transition:
      text-shadow 0.35s ease-out,
      color 0.35s ease-out;
  }

  h3 a:hover {
    color: var(--accent-hover);
    text-shadow: var(--glow-hover);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .date {
    font-size: 12px;
    color: var(--text-date);
  }

  .tag {
    font-size: 11px;
    border: 1px solid var(--chip-border);
    border-radius: 5px;
    padding: 2px 9px;
    color: var(--text-chip);
  }

  .desc {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-desc);
    max-width: 600px;
    text-wrap: pretty;
  }

  .read-more {
    font-size: 13px;
    color: var(--accent);
    font-weight: 500;
    text-shadow: var(--glow-soft);
    transition: text-shadow 0.35s ease-out;
  }

  .read-more:hover {
    text-shadow: var(--glow-hover);
  }

  @media (max-width: 640px) {
    h3 {
      font-size: 18px;
    }
  }
</style>
