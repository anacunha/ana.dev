---
import "../styles/global.css";
import { SITE_NAME } from "../consts";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "Ana Cunha is a software engineer turned developer advocate at AWS, helping people ship things on AWS.",
} = Astro.props;

const pageTitle = title ? `${SITE_NAME} - ${title}` : SITE_NAME;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      if (localStorage.getItem("ana-theme") === "dark") {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
    <script
      is:inline
      defer
      src="https://analytics.ana.dev/script.js"
      data-website-id="2edbf9b3-2177-476f-912c-b61a3bd74c03"></script>
  </head>
  <body>
    <main class="pg">
      <slot />
    </main>
  </body>
</html>
