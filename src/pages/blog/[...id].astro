---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <SiteNav active="blog" />

  <article>
    <header>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span class="date">{formattedDate}</span>
        {post.data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <a href="/blog/" class="back">← back to posts</a>
</BaseLayout>

<style>
  header {
    margin-bottom: 26px;
  }

  h1 {
    margin: 0 0 12px;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.4px;
    line-height: 1.3;
    color: var(--text-heading);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .date {
    font-size: 12px;
    color: var(--text-date);
  }

  .tag {
    font-size: 11px;
    border: 1px solid var(--chip-border);
    border-radius: 5px;
    padding: 2px 9px;
    color: var(--text-chip);
  }

  .prose {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-body);
    max-width: 640px;
  }

  .prose :global(p) {
    margin: 0 0 20px;
    text-wrap: pretty;
  }

  .prose :global(a) {
    color: var(--accent);
    text-shadow: var(--glow-soft);
  }

  .prose :global(a:hover) {
    text-shadow: var(--glow-hover);
  }

  .prose :global(code) {
    font-size: 0.9em;
    background: var(--terminal-bg);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    padding: 1px 6px;
  }

  /* Fenced code blocks: Shiki handles color/background on <pre> itself.
     Reset the inline-code styling above so it doesn't apply per-line. */
  .prose :global(pre) {
    margin: 0 0 20px;
    padding: 16px 19px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    font-size: 0.85em;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }

  .back {
    display: inline-block;
    margin-top: 16px;
    font-size: 13px;
    color: var(--text-link);
    border: 1px solid var(--button-border);
    border-radius: 6px;
    padding: 9px 16px;
    transition:
      border-color 0.25s ease-out,
      color 0.25s ease-out;
  }

  .back:hover {
    border-color: var(--button-border-hover);
    color: var(--button-text-hover);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 23px;
    }
  }
</style>
