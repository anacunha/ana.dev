---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import PostCard from "../../components/PostCard.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });

const groups = posts.reduce<{ year: string; posts: typeof posts }[]>((acc, post) => {
  const year = post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", timeZone: "UTC" });
  const lastGroup = acc[acc.length - 1];
  if (lastGroup?.year === year) {
    lastGroup.posts.push(post);
  } else {
    acc.push({ year, posts: [post] });
  }
  return acc;
}, []);

const tags = ["all", ...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout title="Blog">
  <SiteNav active="blog" />

  <h1>Writing</h1>
  <p class="subtitle">
    $ ls posts/ <span class="filter-label">--all</span>{" "}
    <span class="arrow">→</span>{" "}
    <span class="count">{posts.length} post{posts.length === 1 ? "" : "s"}</span>
  </p>

  <div class="chips">
    {
      tags.map((tag) => (
        <button class:list={["chip", { active: tag === "all" }]} data-tag={tag}>
          #{tag}
        </button>
      ))
    }
  </div>

  {
    groups.map((group) => (
      <div class="year-group" data-year-group>
        <h2 class="year-label">{group.year} /</h2>
        <div class="posts">
          {group.posts.map((post) => (
            <div class="post-wrap" data-tags={post.data.tags.join(",")}>
              <PostCard
                title={post.data.title}
                href={`/blog/${post.id}/`}
                date={formatDate(post.data.pubDate)}
                tags={post.data.tags}
                description={post.data.description}
              />
            </div>
          ))}
        </div>
      </div>
    ))
  }
</BaseLayout>

<style>
  h1 {
    margin: 0 0 8px;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.4px;
    color: var(--text-heading);
  }

  .subtitle {
    margin: 0 0 24px;
    font-size: 13px;
    color: var(--text-date);
  }

  .arrow {
    color: var(--accent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  .chip {
    font-family: inherit;
    font-size: 11px;
    border: 1px solid var(--chip-border);
    border-radius: 5px;
    padding: 3px 10px;
    color: var(--text-chip);
    background: none;
    cursor: pointer;
    transition: border-color 0.25s ease-out;
  }

  .chip:hover {
    border-color: var(--brand);
  }

  .chip.active {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--chip-active-text);
    box-shadow: var(--chip-active-glow);
  }

  .year-label {
    margin: 24px 0 0;
    font-size: 13px;
    font-weight: 400;
    color: var(--text-muted);
  }

  .posts {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 23px;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const postWraps = document.querySelectorAll<HTMLElement>(".post-wrap");
  const yearGroups = document.querySelectorAll<HTMLElement>("[data-year-group]");
  const filterLabel = document.querySelector<HTMLElement>(".filter-label");
  const count = document.querySelector<HTMLElement>(".count");

  function applyFilter(tag: string) {
    let visible = 0;
    postWraps.forEach((wrap) => {
      const tags = wrap.dataset.tags?.split(",") ?? [];
      const show = tag === "all" || tags.includes(tag);
      wrap.style.display = show ? "" : "none";
      if (show) visible++;
    });

    yearGroups.forEach((group) => {
      const hasVisible = [...group.querySelectorAll<HTMLElement>(".post-wrap")].some(
        (wrap) => wrap.style.display !== "none",
      );
      group.style.display = hasVisible ? "" : "none";
    });

    if (filterLabel) filterLabel.textContent = tag === "all" ? "--all" : `--tag ${tag}`;
    if (count) count.textContent = `${visible} post${visible === 1 ? "" : "s"}`;
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("active"));
      chip.classList.add("active");
      applyFilter(chip.dataset.tag ?? "all");
    });
  });
</script>
